{
  "openapi": "3.1.0",
  "info": {
    "title": "pewpew studio",
    "version": "0.1.0"
  },
  "paths": {
    "/api/catalog": {
      "get": {
        "summary": "Get Catalog",
        "operationId": "get_catalog",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Get Catalog"
                }
              }
            }
          }
        }
      }
    },
    "/api/compile": {
      "post": {
        "summary": "Compile Arrangement",
        "operationId": "compile_arrangement",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": true,
                "type": "object",
                "title": "Arrangement"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Compile Arrangement"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Content",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IssueList"
                }
              }
            }
          }
        }
      }
    },
    "/api/assembly/{digest}.glb": {
      "get": {
        "summary": "Get Assembly",
        "operationId": "get_assembly",
        "parameters": [
          {
            "name": "digest",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Digest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Unprocessable Content",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IssueList"
                }
              }
            }
          }
        }
      }
    },
    "/api/arrangements": {
      "post": {
        "summary": "Save Arrangement",
        "operationId": "save_arrangement",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": true,
                "type": "object",
                "title": "Arrangement"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SavedArrangement"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Content",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IssueList"
                }
              }
            }
          }
        }
      }
    },
    "/api/arrangements/{id}": {
      "get": {
        "summary": "Get Arrangement",
        "operationId": "get_arrangement",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Unprocessable Content",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IssueList"
                }
              }
            }
          }
        }
      }
    },
    "/api/patterns": {
      "get": {
        "summary": "List Patterns",
        "operationId": "list_patterns",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/PatternInfo"
                  },
                  "type": "array",
                  "title": "Response List Patterns"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "IssueList": {
        "properties": {
          "issues": {
            "items": {
              "$ref": "#/components/schemas/IssueModel"
            },
            "type": "array",
            "title": "Issues"
          }
        },
        "type": "object",
        "required": [
          "issues"
        ],
        "title": "IssueList"
      },
      "IssueModel": {
        "properties": {
          "level": {
            "type": "string",
            "enum": [
              "error",
              "violation",
              "warning"
            ],
            "title": "Level"
          },
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ref"
          }
        },
        "type": "object",
        "required": [
          "level",
          "code",
          "message"
        ],
        "title": "IssueModel"
      },
      "PatternInfo": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "params": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Params"
          },
          "values": {
            "additionalProperties": true,
            "type": "object",
            "title": "Values"
          }
        },
        "type": "object",
        "required": [
          "name",
          "params",
          "values"
        ],
        "title": "PatternInfo",
        "description": "A gallery pattern: each param's `spec()`, in display order, and the\ndefault values in their JSON form (`ParamSet.snapshot_json()`)."
      },
      "SavedArrangement": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          }
        },
        "type": "object",
        "required": [
          "id"
        ],
        "title": "SavedArrangement"
      }
    }
  }
}
