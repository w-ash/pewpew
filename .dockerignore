# Allowlist: exclude everything, then re-include exactly what the Dockerfile
# copies. Patterns match the full relative path, so a directory rule never
# matches the files inside it — each tree needs both `dir` and `dir/**`. Last
# match wins, so re-exclusions come after the re-include that covered them.
*

# --- Python build inputs (python-builder) ---
!pyproject.toml
!uv.lock
!src
!src/**

# --- The example looks (runtime: `COPY examples/*.look.json`) ---
!examples
!examples/*.look.json

# --- Frontend build inputs (node-builder: the pnpm workspace root, and what the
# studio's page is built from in web/: its shell, the Vite config and the source) ---
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!web
!web/package.json
!web/studio.html
!web/vite.config.ts
!web/dev-origin.ts
!web/tsconfig.json
!web/src
!web/src/**

# --- Junk that would otherwise ride along inside the allowlisted trees ---
**/__pycache__
**/__pycache__/**
**/*.py[cod]
**/.DS_Store

# --- Secrets, databases and caches that a developer's tree may hold inside
# the allowlisted trees (the Python wheel and the Vite build would ship them) ---
**/.env*
**/*.local
**/*.pem
**/*.key
**/*.sqlite3*
**/*.db
**/.pytest_cache
**/.pytest_cache/**
