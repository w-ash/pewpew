# Allowlist: exclude everything, then re-include exactly what the Dockerfile
# copies. Patterns match the full relative path, so a directory rule never
# matches the files inside it — each tree needs both `dir` and `dir/**`. Last
# match wins, so re-exclusions come after the re-include that covered them.
*

# --- Python build inputs (python-builder) ---
!pyproject.toml
!uv.lock
!src
!src/**

# --- The example looks (runtime: `COPY examples/*.look.json`) ---
!examples
!examples/*.look.json

# --- Frontend build inputs (node-builder: the pnpm workspace root, the studio, and
# the control page's source, which the studio imports as a library) ---
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!studio-web
!studio-web/**
!web
!web/package.json
!web/src
!web/src/**

# Dev-only trees inside studio-web/. studio-web/tsconfig.json includes "e2e" as well as "src",
# so studio-web/e2e stays in the build context and is type-checked by `pnpm build`.
studio-web/node_modules
studio-web/node_modules/**
web/node_modules
web/node_modules/**
studio-web/dist
studio-web/dist/**
studio-web/test-results
studio-web/test-results/**
studio-web/playwright-report
studio-web/playwright-report/**
studio-web/playwright.config.ts
studio-web/vitest.config.ts
studio-web/**/*.log

# --- Junk that would otherwise ride along inside the allowlisted trees ---
**/__pycache__
**/__pycache__/**
**/*.py[cod]
**/.DS_Store

# --- Secrets, databases and caches that a developer's tree may hold inside
# the allowlisted trees (the Python wheel and the Vite build would ship them) ---
**/.env*
**/*.local
**/*.pem
**/*.key
**/*.sqlite3*
**/*.db
**/.pytest_cache
**/.pytest_cache/**
studio-web/.vite
studio-web/.vite/**
studio-web/*.tsbuildinfo
studio-web/.eslintcache
